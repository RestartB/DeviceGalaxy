    "@eslint/js": "10.0.1",
    "@svelte-put/cloudflare-turnstile": "1.2.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/enhanced-img": "1.0.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.9",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "sveltekit-rate-limiter": "0.8.0",
    "sveltekit-superforms": "3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-devtools-json": "1.1.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.29",
    "@libsql/client": "0.18.0",
