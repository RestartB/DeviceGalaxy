    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/enhanced-img": "0.11.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
