    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "sveltekit-rate-limiter": "0.7.0",
    "sveltekit-superforms": "2.30.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-devtools-json": "1.1.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.29",
